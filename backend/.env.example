# Copy to backend/.env and fill in. Leave DATABASE_URL unset to use local SQLite (backend/data/market.db).
# URL-encode special characters in the password (e.g. % -> %25, @ -> %40).
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Frontend URLs allowed to call this API (comma-separated). Default: the local Vite dev server.
# CORS_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173
